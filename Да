        #region Отчёт по задачам (Excel)
        private void ExpUIButtonExcel_Click(object sender, EventArgs e)
        {
            Excel.Application ex = new Excel.Application
            {
                SheetsInNewWorkbook = ExcelConfig.numberOfSheets
            };
            Excel.Workbook workBook = ex.Workbooks.Add(Type.Missing);
            ex.DisplayAlerts = false;
            Excel.Worksheet sheet = (Excel.Worksheet)ex.Worksheets.get_Item(1);
            sheet.Name = ExcelConfig.nameSheets;

            sheet.Cells[1, 1] = "Дата создания";
            sheet.Cells[1, 2] = "Срок";
            sheet.Cells[1, 3] = "От кого";
            sheet.Cells[1, 4] = "Кабинет";
            sheet.Cells[1, 5] = "Описание работы";
            sheet.Cells[1, 6] = "Статус задачи";
            sheet.Cells[1, 7] = "Исполнитель";
            sheet.Cells[1, 8] = "Дублер";

            int row = 1;
            try
            {
                using (var cmd = new SQLiteCommand($"SELECT * FROM [{Table_requests.main}]", DB))
                using (var reader = cmd.ExecuteReader())
                {
                    while (reader.Read())
                    {
                        row++;
                        sheet.Cells[row, "A"].Value = Convert.ToString(reader[$"{Table_requests.theDate}"]);
                        sheet.Cells[row, "B"].Value = Convert.ToString(reader[$"{Table_requests.time}"]);
                        sheet.Cells[row, "C"].Value = Convert.ToString(reader[$"{Table_requests.user}"]);
                        sheet.Cells[row, "D"].Value = Convert.ToString(reader[$"{Table_requests.kabinet}"]);
                        sheet.Cells[row, "E"].Value = Convert.ToString(reader[$"{Table_requests.discription}"]);
                        sheet.Cells[row, "F"].Value = Convert.ToString(reader[$"{Table_requests.status}"]);
                        sheet.Cells[row, "G"].Value = Convert.ToString(reader[$"{Table_requests.executor}"]);
                        sheet.Cells[row, "H"].Value = Convert.ToString(reader[$"{Table_requests.executor2}"]);
                    }
                }
            }
            catch (Exception exp)
            {
                MessageBoxUI.Show($"{exp.Message}", $"{exp.Source}", "Error");
                return;
            }

            sheet.Cells.Font.Name = "Times New Roman";
            sheet.Cells.Font.Size = 10;
            sheet.Cells.Borders.get_Item(Excel.XlBordersIndex.xlEdgeBottom).LineStyle = Excel.XlLineStyle.xlContinuous;
            sheet.Cells.Borders.get_Item(Excel.XlBordersIndex.xlEdgeRight).LineStyle = Excel.XlLineStyle.xlContinuous;
            sheet.Cells.Borders.get_Item(Excel.XlBordersIndex.xlInsideHorizontal).LineStyle = Excel.XlLineStyle.xlContinuous;
            sheet.Cells.Borders.get_Item(Excel.XlBordersIndex.xlInsideVertical).LineStyle = Excel.XlLineStyle.xlContinuous;
            sheet.Cells.Borders.get_Item(Excel.XlBordersIndex.xlEdgeTop).LineStyle = Excel.XlLineStyle.xlContinuous;
            sheet.Cells.EntireColumn.AutoFit();
            sheet.Cells.EntireRow.AutoFit();
            sheet.Cells.WrapText = true;
            ex.Visible = true;
        }
        #endregion

        #region Закрыть задачу
        private void ExpUIButtonIconCloseTicket_Click(object sender, EventArgs e)
        {
            if (dataGridViewRequests.SelectedCells.Count > 0)
            {
                int selectedrowindex = dataGridViewRequests.SelectedCells[0].RowIndex;
                DataGridViewRow selectedRow = dataGridViewRequests.Rows[selectedrowindex];
                string data = Convert.ToString(selectedRow.Cells["ColumnData"].Value);
                string user = Convert.ToString(selectedRow.Cells["ColumnFio"].Value);
                string cabinet = Convert.ToString(selectedRow.Cells["ColumnKab"].Value);
                string disc = Convert.ToString(selectedRow.Cells["ColumnDisc"].Value);

                using (var cmd = new SQLiteCommand($"SELECT * FROM [{Table_requests.main}] WHERE [{Table_requests.theDate}] = @theDate AND [{Table_requests.user}] = @user AND [{Table_requests.kabinet}] = @cabinet AND [{Table_requests.discription}] = @disc", DB))
                {
                    cmd.Parameters.AddWithValue("theDate", data);
                    cmd.Parameters.AddWithValue("user", user);
                    cmd.Parameters.AddWithValue("cabinet", cabinet);
                    cmd.Parameters.AddWithValue("disc", disc);

                    using (var reader = cmd.ExecuteReader())
                    {
                        while (reader.Read())
                        {
                            DataRequests.Kod = Convert.ToString(reader["id"]);
                            DataRequests.Tema = Convert.ToString(reader[$"{Table_requests.tema}"]);
                            DataRequests.TheDate = Convert.ToString(reader[$"{Table_requests.theDate}"]);
                            DataRequests.Type = Convert.ToString(reader[$"{Table_requests.typeProblem}"]);
                            DataRequests.User = Convert.ToString(reader[$"{Table_requests.user}"]);
                            DataRequests.Kabinet = Convert.ToString(reader[$"{Table_requests.kabinet}"]);
                            DataRequests.Time = Convert.ToString(reader[$"{Table_requests.time}"]);
                            DataRequests.Discription = Convert.ToString(reader[$"{Table_requests.discription}"]);
                            DataRequests.Executor = Convert.ToString(reader[$"{Table_requests.executor}"]);
                            DataRequests.Result = Convert.ToString(reader["result"]);
                            DataRequests.NameFile = Convert.ToString(reader[$"{Table_requests.nameFile}"]);
                            DataRequests.PathTo = Convert.ToString(reader[$"{Table_requests.pathFile}"]);
                            DataRequests.NameFileResult = Convert.ToString(reader[$"{Table_requests.nameFileResult}"]);
                            DataRequests.PathResultTo = Convert.ToString(reader[$"{Table_requests.pathFileResult}"]);

                            Form fCloseTicket = new CloseRequestForm();
                            fCloseTicket.Show();
                        }
                    }
                }
            }
        }
