        private void MonthCalendar_DateSelected(object sender, DateRangeEventArgs e)
        {
            string date = monthCalendar.SelectionRange.Start.ToShortDateString();
            dataGridViewRequests.Rows.Clear();

            using (var cmd = new SQLiteCommand($"SELECT * FROM [{Table_requests.main}] WHERE {Table_requests.time} LIKE @date", DB))
            {
                cmd.Parameters.AddWithValue("date", $"%{date}%");

                using (var reader = cmd.ExecuteReader())
                {
                    while (reader.Read())
                    {
                        dataGridViewRequests.Rows.Add(
                            Convert.ToString(reader[$"{Table_requests.theDate}"]),
                            Convert.ToString(reader[$"{Table_requests.time}"]),
                            Convert.ToString(reader[$"{Table_requests.user}"]),
                            Convert.ToString(reader[$"{Table_requests.kabinet}"]),
                            Convert.ToString(reader[$"{Table_requests.discription}"]),
                            Convert.ToString(reader[$"{Table_requests.status}"]),
                            Convert.ToString(reader[$"{Table_requests.executor}"]),
                            Convert.ToString(reader[$"{Table_requests.executor2}"]));
