        // Общая подсветка строк таблицы заявок
        private void ColorizeGrid()
        {
            for (int i = 0; i < dataGridViewRequests.RowCount; i++)
            {
                string status = Convert.ToString(dataGridViewRequests["ColumnStatus", i].Value);
                Color c;

                if (status == "Выполнена") c = Color.Lime;
                else if (status == "На подтверждении") c = Color.Yellow;
                else if (status == "Отклонена" || status == "Не выполнена") c = Color.Red;
                else c = Color.White;

                foreach (DataGridViewCell cell in dataGridViewRequests.Rows[i].Cells)
                    cell.Style.BackColor = c;
            }
        }

