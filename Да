        // ============================================================
        private void LoadAllEvents()
        {
            try
            {
                using (var conn = new SQLiteConnection(eventsConnectionString))
                {
                    conn.Open();

                    // Создаём таблицу Events, если её ещё нет
                    string createSql = @"CREATE TABLE IF NOT EXISTS Events (
                                             Id          INTEGER PRIMARY KEY AUTOINCREMENT,
                                             Name        TEXT NOT NULL,
                                             Date        TEXT NOT NULL,
                                             Place       TEXT,
                                             Description TEXT,
                                             Completed   INTEGER NOT NULL DEFAULT 0
                                         );";
                    using (var createCmd = new SQLiteCommand(createSql, conn))
                        createCmd.ExecuteNonQuery();

                    // Читаем все мероприятия
                    string sql = @"SELECT Name        AS Название,
                                          Date        AS Дата,
                                          Place       AS Место,
                                          Description AS Описание,
                                          Completed   AS Проведено
                                   FROM Events
                                   ORDER BY Date;";

                    using (var adapter = new SQLiteDataAdapter(sql, conn))
                    {
                        var dt = new DataTable();
                        adapter.Fill(dt);

                        // 0/1 → настоящий bool (DataGridView покажет чекбокс)
                        if (dt.Columns.Contains("Проведено"))
                        {
                            int idx = dt.Columns["Проведено"].Ordinal;
                            dt.Columns["Проведено"].ColumnName = "Проведено_old";

                            var boolCol = new DataColumn("Проведено", typeof(bool));
                            dt.Columns.Add(boolCol);

                            foreach (DataRow r in dt.Rows)
                                r["Проведено"] = Convert.ToInt32(r["Проведено_old"]) == 1;

                            dt.Columns.Remove("Проведено_old");
                            boolCol.SetOrdinal(idx);
                        }

                        dgvAllEvents.DataSource = dt;

                        foreach (DataGridViewColumn col in dgvAllEvents.Columns)
                            col.ReadOnly = true;
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBoxUI.Show($"{ex.Message}", $"{ex.Source}", "Error");
            }
        }
    }
