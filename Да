        private void MainAdminForm_Load(object sender, EventArgs e)
        {
            try
            {
                // === База SupportDesk ===
                DB = new SQLiteConnection(Database.connectionString);
                DB.Open();

                // Включаем WAL — снижает вероятность блокировок
                using (var pragma = new SQLiteCommand("PRAGMA journal_mode=WAL;", DB))
                    pragma.ExecuteScalar();

                labelName.Text = DataUsers.Name + " " + DataUsers.Father;
                comboBoxExecutors.SelectedItem = "Все пользователи";
                comboBoxTypeJob.SelectedItem = "Все работы";
                comboBoxCabinets.SelectedItem = "Все кабинеты";

                // ПОСЛЕДОВАТЕЛЬНО загружаем списки (не параллельно!)
                LoadingExecutors();
                LoadingStatus();
                comboBoxRequest.SelectedItem = "Новая";
                LoadingTypeJob();
                LoadingCabinets();
                LoadingRequests();
                LoadingUsers();
                LoadingInventory();
                LoadingConfigWidgets();
                LoadingImageAvatar();

                // === Отдельная база мероприятий ===
                LoadAllEvents();
            }
            catch (Exception ex)
            {
                MessageBoxUI.Show($"{ex.Message}", $"{ex.Source}", "Error");
            }
        }

