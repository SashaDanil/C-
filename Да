        #region Вход
        [Obsolete]
        private void ButtonEnterLogin_Click(object sender, EventArgs e)
        {
            DataTable table = new DataTable();
            SQLiteDataAdapter adapter = new SQLiteDataAdapter();

            using (var command = new SQLiteCommand(
                $"SELECT * FROM [{Table_users.main}] WHERE [{Table_users.login}] = @login AND [{Table_users.pass}] = @pass", DB))
            {
                command.Parameters.AddWithValue("login", TextBoxLogin.Text);
                command.Parameters.AddWithValue("pass", TextBoxPassword.Text);

                try
                {
                    adapter.SelectCommand = command;
                    adapter.Fill(table);

                    if (table.Rows.Count > 0)
                    {
                        // Пользователь найден
                        using (var reader = command.ExecuteReader())
                        {
                            while (reader.Read())
                            {
                                string checkLocked = reader[$"{Table_users.typeAccess}"].ToString();

                                if (string.IsNullOrEmpty(checkLocked))
                                {
                                    DataUsers.Family    = reader[$"{Table_users.family}"].ToString();
                                    DataUsers.Name      = reader[$"{Table_users.name}"].ToString();
                                    DataUsers.Father    = reader[$"{Table_users.father}"].ToString();
                                    DataUsers.Initials  = reader[$"{Table_users.initials}"].ToString();
                                    DataUsers.Gender    = reader[$"{Table_users.gender}"].ToString();
                                    DataUsers.Number    = reader[$"{Table_users.number}"].ToString();
                                    DataUsers.Email     = reader[$"{Table_users.email}"].ToString();
                                    DataUsers.Depart    = reader[$"{Table_users.depart}"].ToString();
                                    DataUsers.Position  = reader[$"{Table_users.position}"].ToString();
                                    DataUsers.Login     = reader[$"{Table_users.login}"].ToString();
                                    DataUsers.Pass      = reader[$"{Table_users.pass}"].ToString();
                                    DataUsers.GroupUser = reader[$"{Table_users.groupUser}"].ToString();
                                    DataUsers.Image     = reader[$"{Table_users.image}"].ToString();

                                    string group = reader[$"{Table_users.groupUser}"].ToString();

                                    // Закрываем reader ДО открытия новой формы
                                    reader.Close();

                                    Form fMain;
                                    if (group == "ADMIN")
                                        fMain = new MainAdminForm();
                                    else if (group == "WORKER")
                                        fMain = new MainWorkerForm();
                                    else
                                        fMain = new MainUserForm();

                                    fMain.Show();
                                    fMain.FormClosed += new FormClosedEventHandler(Form_FormClosed);
                                    Hide();

                                    File.AppendAllText(Logs.file,
                                        $"[Вход]{DataUsers.Initials} ({thisDay:dd.MM.yyyy HH:mm})");
                                    File.AppendAllText(Logs.file, Environment.NewLine);
                                    CheckValidatePassword();

                                    return; // выходим — соединение DB не закрываем, оно общее
                                }
                                else
                                {
                                    MessageBoxUI.Show(
                                        "Учетная запись заблокирована! Свяжитесь с системным администратором для восстановления.",
                                        "Ошибка авторизации", "Error");
                                    Close();
                                    return;
                                }
                            }
                        }
                    }
                    else
                    {
                        // Пользователь не найден — проверяем логин и попытки
                        string login = TextBoxLogin.Text;

                        using (var commandCheck = new SQLiteCommand(
                            $"SELECT * FROM [{Table_users.main}] WHERE [{Table_users.login}]=@login", DB))
                        {
                            commandCheck.Parameters.AddWithValue("login", login);

                            using (var reader = commandCheck.ExecuteReader())
                            {
                                while (reader.Read())
                                {
                                    string check = reader[$"{Table_users.typeAccess}"].ToString();

                                    if (attemptLogin > 0 && check != "LOCKED")
                                    {
                                        attemptLogin -= 1;
                                        MessageBoxUI.Show("Неверный логин или пароль",
                                            "Ошибка авторизации", "Error");
                                    }
                                    else
                                    {
                                        string locked = "LOCKED";

                                        reader.Close(); // закрываем ПЕРЕД update

                                        using (var commandUpdate = new SQLiteCommand(
                                            $"UPDATE {Table_users.main} SET [{Table_users.typeAccess}]=@locked WHERE [{Table_users.login}] = @login", DB))
                                        {
                                            commandUpdate.Parameters.AddWithValue("login", login);
                                            commandUpdate.Parameters.AddWithValue("locked", locked);
                                            commandUpdate.ExecuteNonQuery();
                                        }

                                        File.AppendAllText(Logs.file,
                                            $"[Вход]Учетная запись пользователя {login} заблокирована!({thisDay:dd.MM.yyyy HH:mm})");
                                        File.AppendAllText(Logs.file, Environment.NewLine);

                                        MessageBoxUI.Show(
                                            "Учетная запись заблокирована! Свяжитесь с системным администратором для восстановления.",
                                            "Ошибка авторизации", "Error");
                                        Close();
                                        return;
                                    }
                                }
                            }
                        }

                        // Если пользователя с таким логином нет — просто сообщаем
                        if (table.Rows.Count == 0)
                        {
                            MessageBoxUI.Show("Неверный логин или пароль",
                                "Ошибка авторизации", "Error");
                        }
                    }
                }
                catch (Exception ex)
                {
                    MessageBoxUI.Show($"{ex.Message}", $"{ex.Source}", "Error");
                }
            }
        }

